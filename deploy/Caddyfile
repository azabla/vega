# Caddy edge for Vega (docker compose --profile edge). See docs/15.
#
# One catch-all site with on-demand TLS: the first HTTPS request for a host makes Caddy ask
# the backend (/api/sites/tls-allowed/) whether the host belongs to Vega (the main domain, a
# user's subdomain or a verified custom domain). Only then does it get a Let's Encrypt
# certificate, so nobody can make it request certificates for random names.
{
	# Optional: an email for Let's Encrypt expiry notices
	# email you@example.com
	on_demand_tls {
		ask http://web/api/sites/tls-allowed/
	}
}

# Another site that used to be served by the host Nginx (e.g. the Laravel app): move that
# Nginx to port 8080 (listen 127.0.0.1:8080) and uncomment, with its real domain.
# laravel.example.com {
# 	reverse_proxy host.docker.internal:8080
# }

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy web:80
}

# Plain HTTP: redirect to HTTPS (certificates are issued over the HTTPS handshake)
http:// {
	redir https://{host}{uri} permanent
}
