# systemd unit: runs Django with Gunicorn and restarts it if it crashes or the server reboots.
# Install: sudo cp deploy/vega.service /etc/systemd/system/vega.service
# Replace YOUR_USER with the Linux user that owns /var/www/vega.

[Unit]
Description=Vega portfolio (Django + Gunicorn)
After=network.target postgresql.service

[Service]
User=YOUR_USER
Group=www-data
WorkingDirectory=/var/www/vega/backend
# settings.py reads backend/.env itself
ExecStart=/var/www/vega/backend/venv/bin/gunicorn core.wsgi:application \
    --bind 127.0.0.1:8010 \
    --workers 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
