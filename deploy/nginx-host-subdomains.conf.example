# Subdomains only, keeping the host Nginx (no Caddy). See docs/15, "Option B".
# Serves <username>.andu.aetechsolution.et with a wildcard certificate, which Let's Encrypt only
# issues with a DNS challenge, e.g.:
#   sudo certbot certonly --manual --preferred-challenges dns \
#     -d andu.aetechsolution.et -d '*.andu.aetechsolution.et'
# (or a certbot DNS plugin for your DNS provider, so renewals are automatic)

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.andu.aetechsolution.et;

    ssl_certificate     /etc/letsencrypt/live/andu.aetechsolution.et/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/andu.aetechsolution.et/privkey.pem;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name *.andu.aetechsolution.et;
    return 301 https://$host$request_uri;
}
