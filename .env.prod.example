# Production settings for docker-compose.prod.yml.
# On the server: cp .env.prod.example .env.prod && nano .env.prod
# Never commit .env.prod.

# Public domain (used by Django and the health check)
DOMAIN=andu.aetechsolution.et

# Django
SECRET_KEY=generate-with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=andu.aetechsolution.et
CSRF_TRUSTED_ORIGINS=https://andu.aetechsolution.et
CORS_ALLOWED_ORIGINS=
REGISTRATION_OPEN=false

# PostgreSQL (only reachable inside the Docker network)
POSTGRES_PASSWORD=generate-with: openssl rand -hex 24

# Frontend: whose portfolio the home page "/" shows (your username)
PORTFOLIO_USERNAME=vega

# Host port the host Nginx forwards to (127.0.0.1 only)
WEB_PORT=8010
GUNICORN_WORKERS=2
