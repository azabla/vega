# Copy to .env and fill in. Never commit .env.

DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Local development: SQLite file. Production: PostgreSQL.
DATABASE_URL=sqlite:///dev.sqlite3
# DATABASE_URL=postgres://vega:PASSWORD@127.0.0.1:5432/vega

# Only needed when the frontend is on a different origin (local dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production: the public https origin
CSRF_TRUSTED_ORIGINS=

# false = nobody can sign up through the API (personal deployment)
REGISTRATION_OPEN=true
